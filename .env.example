# ──────────────────────────────────────────────
# AccOS Backend – Environment Configuration
# Copy this file to `.env` and fill in real values.
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME="AccOS E-Learning API"
APP_VERSION="0.1.0"
DEBUG=true

# ── Database (PostgreSQL + asyncpg) ──────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accos_db

# ── JWT / Auth ───────────────────────────────
SECRET_KEY=change-me-to-a-real-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI / Gemini ──────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
AI_DAILY_QUOTA=50
